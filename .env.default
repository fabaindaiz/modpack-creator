ENVIRONMENT: "PROD"
SESSION_SECRET: "supersecret"
OIDC_CLIENT_ID: "CLIENT_ID_HERE"
OIDC_CLIENT_SECRET: "CLIENT_SECRET_HERE"
OIDC_METADATA_URL: "SERVER_METADATA_URL_HERE"
# Quién puede usar la API (grupos del IdP, separados por coma). Vacío = nadie.
OIDC_ALLOWED_GROUPS: "modpack-admins"
# Opcional: emails permitidos aunque no estén en un grupo.
OIDC_ALLOWED_EMAILS: ""
# "false" solo si se sirve por HTTP sin TLS (no recomendado).
SESSION_HTTPS_ONLY: "true"
SESSION_MAX_AGE: "43200"
# Opcional: orígenes permitidos para CORS, separados por coma. Vacío = sin CORS.
CORS_ALLOW_ORIGINS: ""
MODRINTH_AGENT: "github_username/project_name"
MODRINTH_TOKEN: "MODRINTH_TOKEN_HERE_OR_NULL"
PTERODACTYL_API_URL: "https://pterodactyl.example.com/api"
PTERODACTYL_TOKEN: "PTERODACTYL_TOKEN_HERE"
# "enabled" deja que la API escriba en los servidores (energía, comandos, borrar, subir). Vacío =
# solo lectura: leer y escanear servidores no lo necesita.
PTERODACTYL_WRITES: ""
# Opcional: URL de un webhook de Discord para los avisos (builds nuevos, servidores que se
# desvían de su build). Es un secreto: lleva el token del webhook. Vacío = sin avisos.
DISCORD_WEBHOOK_URL: ""
# Opcional: "off" apaga el worker de trabajos en este proceso (por defecto corre).
JOBS_WORKER: "on"
# Opcional: cada cuántas horas escanear cada servidor (vacío = nunca), y cada cuántos días un
# escaneo completo, que vuelve a hashear todo.
SCAN_EVERY_HOURS: ""
SCAN_FULL_EVERY_DAYS: "7"
# Opcional: DEBUG, INFO (por defecto), WARNING o ERROR. Los logs salen en JSON.
LOG_LEVEL: "INFO"
MONGODB_URI: "mongodb://user:password@localhost:5432"