# Template for .env.yaml (the API's configuration). Copy it to .env.yaml and fill it in; .env.yaml
# is never committed. ALL values go in quotes: YAML reads 10:30 or 43200 unquoted as numbers, and
# the loader drops them (UPDATE_CHECK_* makes startup fail instead). Variables not marked
# "Optional" are required: without them the API does not start.

# ── Session ─────────────────────────────────────────────────────────────────────────────────────
# Secret that signs the session cookie. Generate a long, unique one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it ends every session (use it to revoke an operator role before it expires).
SESSION_SECRET: ""
# "false" only when served over plain HTTP without TLS (not recommended).
SESSION_HTTPS_ONLY: "true"
# Session lifetime in seconds (43200 = 12 h). A role change applies on the next login.
SESSION_MAX_AGE: "43200"

# ── MongoDB ─────────────────────────────────────────────────────────────────────────────────────
# Inside the compose: the root user from docker/.env and the "mongodb" service. No database name:
# the app uses its own (modpack, modrinth, pterodactyl, userdata, jobs, audit).
MONGODB_URI: "mongodb://mongoadmin:PASSWORD@mongodb:27017"

# ── OIDC login (authentik) ──────────────────────────────────────────────────────────────────────
OIDC_CLIENT_ID: ""
OIDC_CLIENT_SECRET: ""
# https://<authentik>/application/o/<app-slug>/.well-known/openid-configuration
OIDC_METADATA_URL: ""
# Who may use the API: IdP groups, comma-separated. Empty = nobody gets in.
OIDC_ALLOWED_GROUPS: "modpack-admins"
# IdP groups that may also write to servers (update, simulate, roll back, import, link).
# Operators must also be in OIDC_ALLOWED_GROUPS. Empty = nobody operates.
OIDC_OPERATOR_GROUPS: ""
# Optional: emails allowed even when not in a group (only if the IdP marks them verified).
# They never grant the operator role.
OIDC_ALLOWED_EMAILS: ""

# ── Pterodactyl ─────────────────────────────────────────────────────────────────────────────────
# Panel API URL, with the trailing slash.
PTERODACTYL_API_URL: "https://pterodactyl.example.com/api/"
# Client key (ptlc_…) of a NON-admin service user, restricted with allowed_ips.
PTERODACTYL_TOKEN: ""
# "enabled" lets the API write to servers (power, commands, delete, upload, backups).
# Empty = read-only: reading, scanning and dry runs don't need it.
PTERODACTYL_WRITES: ""

# ── Modrinth ──────────────────────────────────────────────────────────
# User-Agent Modrinth asks for: identifies.
MODRINTH_AGENT: "github_username/modpack-cm"
# Optional: Modrinth token. Empty = no tokd one).
MODRINTH_TOKEN: ""
# Optional, for testing only: external API
# MODRINTH_API_URL: "https://api.modrinth.
# FABRIC_META_URL: "https://meta.fabricmc.
# QUILT_META_URL: "https://meta.quiltmc.or

# ── Notifications ─────────────────────────────────────────────────────
# Optional: Discord webhook for notices (ng from their build, available
# updates). It is a secret: it carries the notices.
DISCORD_WEBHOOK_URL: ""

# ── Jobs and scheduling ───────────────────────────────────────────────
# Optional: "off" disables the job worker y default).
JOBS_WORKER: "on"
# Optional: how often, in hours, to scan e, and how often, in days, to
# run a full scan that rehashes everything
SCAN_EVERY_HOURS: ""
SCAN_FULL_EVERY_DAYS: "7"
# Optional: daily time (HH:MM, quoted) of k. Empty = no scheduled check
# (the panel button still works). A manualunts as the day's check.
UPDATE_CHECK_AT: ""
# Optional: time zone of UPDATE_CHECK_AT (
# UPDATE_CHECK_TZ: "America/Santiago"

# ── HTTP, docs and logs ───────────────────────────────────────────────
# Optional: origins allowed for CORS, commRS. An origin listed here can
# only read: every write from another orig
CORS_ALLOW_ORIGINS: ""
# Optional: DEBUG, INFO (default), WARNING
LOG_LEVEL: "INFO"
# Optional: paths of the API docs (Swaggery default).
# DOCS_PATH: "/docs"
# REDOCS_PATH: "/redoc"
# Optional: version the API reports, and t, in seconds.
# VERSION: "1.0.0"
# CONNECT_TIMEOUT: "5"
# REQUEST_TIMEOUT: "30"

# The app does not read this one (the compbe deleted.
# ENVIRONMENT: "PROD"
