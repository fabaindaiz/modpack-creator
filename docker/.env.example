# Plantilla de docker/.env, el archivo que lee docker-compose.yaml (no se versiona: `.gitignore`
# cubre `.env`). Copiarla a docker/.env y completar cada valor; sin uno, el compose no arranca.
# La configuración de la API no va aquí: va en .env.yaml (plantilla .env.default).

# La versión de la imagen de Mongo: igual o mayor que la que escribió los datos, y a lo sumo una
# mayor arriba (d-7985ee-398653; docs/runbooks/migrar-mongo-a-volumen.md).
MONGO_VERSION=8.0

# La contraseña del usuario root de Mongo (mongoadmin). La misma va en MONGODB_URI de .env.yaml.
MONGODB_PASSWORD=

# La contraseña de mongo-express, que solo se levanta a pedido (perfil admin).
MONGOWEB_PASSWORD=

# La IP de LAN de este servidor por la que llega el proxy inverso, que corre en otra máquina. La
# API se publica solo en ella (puerto 8000).
API_BIND_IP=

# La IP del proxy inverso, tal como la ve el contenedor: uvicorn solo confía en su
# X-Forwarded-Proto, y el chequeo de origen del panel lo necesita (d-7985ee-491c83).
FORWARDED_ALLOW_IPS=
