{
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:css": "tailwindcss -i src/web/assets/app.css -o src/web/static/dist/app.css --minify",
    "build:js": "node -e \"const fs=require('fs');fs.mkdirSync('src/web/static/dist',{recursive:true});fs.copyFileSync('node_modules/htmx.org/dist/htmx.min.js','src/web/static/dist/htmx.min.js');fs.copyFileSync('node_modules/htmx.org/LICENSE','src/web/static/dist/LICENSE-htmx.txt')\"",
    "build": "npm run build:js && npm run build:icons && npm run build:css",
    "dev": "npm run build:js && npm run build:icons && tailwindcss -i src/web/assets/app.css -o src/web/static/dist/app.css --watch",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "htmx.org": "2.0.11",
    "lucide-static": "1.56.0",
    "tailwindcss": "4.3.3"
  }
}
