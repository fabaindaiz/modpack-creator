{
  "private": true,
  "engines": {"node": ">=24"},
  "scripts": {
    "build:css": "tailwindcss -i src/web/assets/app.css -o src/web/static/dist/app.css --minify",
    "build:js": "node -e \"require('fs').mkdirSync('src/web/static/dist',{recursive:true});require('fs').copyFileSync('node_modules/htmx.org/dist/htmx.min.js','src/web/static/dist/htmx.min.js')\"",
    "build": "npm run build:js && npm run build:css",
    "dev": "npm run build:js && tailwindcss -i src/web/assets/app.css -o src/web/static/dist/app.css --watch"
  },
  "devDependencies": {"tailwindcss": "4.3.3", "@tailwindcss/cli": "4.3.3", "htmx.org": "2.0.11"}
}
